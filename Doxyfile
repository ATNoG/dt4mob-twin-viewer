# Doxyfile for the DT4MOB Twin Viewer
#
# Generate with:  doxygen Doxyfile
# Output:         Docs/Doxygen/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "DT4MOB Twin Viewer"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Real-time 3D viewer for the DT4MOB mobility digital twin (Unreal Engine 5.6)"
OUTPUT_DIRECTORY       = Docs/Doxygen
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = Source/DT4MOB
STRIP_FROM_INC_PATH    = Source/DT4MOB/Public

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = Documentation \
                         Source/DT4MOB
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.md *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */ThirdParty/* \
                         */Intermediate/* \
                         */Binaries/*
# BlueprintNativeEvent bodies (Foo_Implementation) are documented on the UFUNCTION declaration.
EXCLUDE_SYMBOLS        = *_Implementation
USE_MDFILE_AS_MAINPAGE = Documentation/mainpage.md
IMAGE_PATH             = Documentation

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Extraction
#
# EXTRACT_ALL is off on purpose: every symbol in the project is documented,
# and with it off Doxygen warns about anything new that is not.
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
DISTRIBUTE_GROUP_DOC   = YES
SORT_MEMBER_DOCS       = NO

#---------------------------------------------------------------------------
# Preprocessing
#
# Unreal's reflection macros (UCLASS, UPROPERTY, ...) carry no meaning for the
# docs and confuse the C++ parser, so they expand to nothing. Dynamic delegate
# declarations expand to a type alias so each delegate shows up as a
# documented type with its signature.
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = "UCLASS(...)=" \
                         "USTRUCT(...)=" \
                         "UENUM(...)=" \
                         "UINTERFACE(...)=" \
                         "UPROPERTY(...)=" \
                         "UFUNCTION(...)=" \
                         "UMETA(...)=" \
                         "UPARAM(...)=" \
                         "GENERATED_BODY()=" \
                         "GENERATED_USTRUCT_BODY()=" \
                         "GENERATED_UCLASS_BODY()=" \
                         "GENERATED_IINTERFACE_BODY()=" \
                         "DT4MOB_API=" \
                         "FORCEINLINE=inline" \
                         "PURE_VIRTUAL(...)==0" \
                         "DECLARE_LOG_CATEGORY_EXTERN(...)=" \
                         "DEFINE_LOG_CATEGORY(...)=" \
                         "DEFINE_LOG_CATEGORY_STATIC(...)=" \
                         "IMPLEMENT_PRIMARY_GAME_MODULE(...)=" \
                         "DECLARE_DYNAMIC_MULTICAST_DELEGATE(N)=using N = TMulticastDelegate<void()>" \
                         "DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(N,T1,P1)=using N = TMulticastDelegate<void(T1 P1)>" \
                         "DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams(N,T1,P1,T2,P2)=using N = TMulticastDelegate<void(T1 P1, T2 P2)>" \
                         "DECLARE_DYNAMIC_MULTICAST_DELEGATE_ThreeParams(N,T1,P1,T2,P2,T3,P3)=using N = TMulticastDelegate<void(T1 P1, T2 P2, T3 P3)>" \
                         "DECLARE_DYNAMIC_DELEGATE_OneParam(N,T1,P1)=using N = TDelegate<void(T1 P1)>"

#---------------------------------------------------------------------------
# Diagrams (class diagrams need Graphviz; set HAVE_DOT = YES if it is installed)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = Docs/Doxygen/warnings.log
